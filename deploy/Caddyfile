# 当前 GitHub Actions 上线方案使用的配置，配套 deploy/compose.yaml。
# 工作流上传本文件，release.sh 将其放到部署目录，再挂载到 /etc/caddy/Caddyfile。
# 请求链路：浏览器 HTTPS → 宝塔 Nginx（证书与域名）→ Caddy HTTP → 应用服务。
# Nginx 将前台转发到 127.0.0.1:6325，后台转发到 127.0.0.1:6326。
# Compose 仅将这两个宿主机端口绑定到回环地址，避免公网绕过 Nginx 直接访问。
# api、web 是容器网络内的服务名；后台静态文件已打包在代理镜像的 /srv/admin。
{
	# 关闭 Caddy 自动申请证书和自动 HTTPS 重定向；证书由外层 Nginx 管理。
	# 下方仅端口形式的站点使用 HTTP，Nginx 到容器的本机转发无需再次配置证书。
	auto_https off
}

# 定义名为 api 的可复用配置片段，本身不创建监听站点。
# 前台和后台通过 import api 复用接口代理与上传文件访问规则。
(api) {
	# 匹配 /api/ 下的接口，包括 /api/v1/*；handle 不删除 /api 前缀。
	# 浏览器可直接请求当前站点的 /api/v1/...，无需跨域访问另一个接口域名。
	handle /api/* {
		# 转发到 Gin 后端的容器内部端口；不是重新访问宿主机公网入口。
		reverse_proxy api:6324 {
			# 保留外层 Nginx 传入的原始协议（通常为 https），避免应用误判成内部 HTTP。
			# 仅在可信 Nginx 已覆盖此请求头、容器入口未直接暴露公网的前提下使用。
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			# 保留 Nginx 确定的客户端 IP，避免后端只看到代理容器的地址。
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}
	# 上传文件入口：handle_path 会剥离 /uploads/ 前缀。
	# 例如 /uploads/example.png 对应 /srv/uploads/example.png；该目录来自上传文件卷。
	handle_path /uploads/* {
		# 为当前处理分支指定文件根目录；* 表示匹配所有请求。
		root * /srv/uploads
		# 告诉浏览器按响应的 Content-Type 处理资源，不自行猜测文件类型。
		header X-Content-Type-Options nosniff
		# 从上面设置的根目录返回静态文件；未开启目录浏览。
		file_server
	}
}

# 前台内部 HTTP 入口，域名及 HTTPS 校验已由外层 Nginx 完成。
:6325 {
	# 根据浏览器支持情况压缩可压缩响应，减少 HTML、CSS、JS 等传输体积。
	encode zstd gzip
	# 展开上方 api 片段，使当前入口也具备 /api/* 和 /uploads/* 路由。
	import api
	# 命名匹配器：这些站点地图、订阅源和爬虫规则由 Go 后端生成。
	# 将它们单独交给 API，避免落入前台 SSR 页面路由。
	@discovery path /sitemap.xml /feed.xml /notes/feed.xml /thinking/feed.xml /says/feed.xml /robots.txt
	# 匹配上面的 @discovery 路径，保留原始请求路径转发。
	handle @discovery {
		# 保留请求路径并转发到 Go Gin 后端的内部端口。
		reverse_proxy api:6324
	}
	# 不带匹配条件的兜底分支：处理未被其他 handle 分支接管的请求。
	handle {
		# 将页面请求转发给前台 SSR 服务，由它生成 HTML 并提供相关资源。
		reverse_proxy web:6325 {
			# 保留外层 Nginx 传入的原始协议（通常为 https），避免应用误判成内部 HTTP。
			# 仅在可信 Nginx 已覆盖此请求头、容器入口未直接暴露公网的前提下使用。
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}
}

# 后台内部 HTTP 入口：接口交给 Gin，页面由 Caddy 返回静态文件。
:6326 {
	# 根据浏览器支持情况压缩可压缩响应，减少 HTML、CSS、JS 等传输体积。
	encode zstd gzip
	# 展开上方 api 片段，使当前入口也具备 /api/* 和 /uploads/* 路由。
	import api
	# 不带匹配条件的兜底分支：处理未被其他 handle 分支接管的请求。
	handle {
		# 后台静态文件根目录：Dockerfile.proxy 将 admin/dist 复制到这里。
		root * /srv/admin
		# 优先返回真实文件；找不到时返回 React 单页应用入口 index.html。
		# 这样直接打开或刷新后台子路由也能由前端路由接管。
		try_files {path} /index.html
		# 从上面设置的根目录返回静态文件；未开启目录浏览。
		file_server
	}
}
