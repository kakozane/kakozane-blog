localhost:6324 {
	# API 也经由 HTTPS 对外提供，Gin 只在容器网络内监听。
	tls internal
	reverse_proxy api:6324 {
		header_up X-Real-IP {remote_host}
	}
}

localhost:6325 {
	# 前台同源代理 API，其余请求交给 React Router SSR。
	tls internal
	@discovery path /sitemap.xml /feed.xml /notes/feed.xml /thinking/feed.xml /says/feed.xml /robots.txt
	handle @discovery {
		reverse_proxy api:6324
	}
	handle /api/* {
		reverse_proxy api:6324 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /uploads/* {
		root * /srv/uploads
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy web:6325
	}
}

localhost:6326 {
	# 后台同源代理 API，并将页面路由回退到入口文件。
	tls internal
	handle /api/* {
		reverse_proxy api:6324 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /uploads/* {
		root * /srv/uploads
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
