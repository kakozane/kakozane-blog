# Caddy 独立作为公网入口的生产方案，配套根目录 compose.prod.yaml。
# 当前 GitHub Actions + 宝塔 Nginx 部署使用 deploy/Caddyfile，不使用本文件。
# 此方案由 Caddy 接管公网 80/443；不能与占用相同地址端口的 Nginx 同时运行。
# 正式域名需要解析到服务器，并允许证书验证请求到达 Caddy。
# 域名站点默认启用自动 HTTPS：申请、续期证书，并将 HTTP 重定向到 HTTPS。
# /data 通过 caddy_data 卷持久保存证书等状态，避免容器重建后丢失。
# api、web 是 Docker 内部服务名；后台构建产物由镜像内 /srv/admin 提供。
# www 域名入口：统一跳转到主域名。
www.retniw.cc {
	# 返回永久重定向（301），保留原请求的路径与查询参数。
	redir https://retniw.cc{uri} permanent
}

# 博客主站入口：订阅与接口交给 Go，其余页面交给 SSR 服务。
retniw.cc {
	# 根据浏览器支持情况压缩可压缩响应，减少 HTML、CSS、JS 等传输体积。
	encode zstd gzip
	# 告诉浏览器按响应的 Content-Type 处理资源，不自行猜测文件类型。
	header X-Content-Type-Options nosniff
	# 命名匹配器：这些站点地图、订阅源和爬虫规则由 Go 后端生成。
	# 将它们单独交给 API，避免落入前台 SSR 页面路由。
	@discovery path /sitemap.xml /feed.xml /notes/feed.xml /thinking/feed.xml /says/feed.xml /robots.txt
	# 匹配上面的 @discovery 路径，保留原始请求路径转发。
	handle @discovery {
		# 保留请求路径并转发到 Go Gin 后端的内部端口。
		reverse_proxy api:6324
	}
	# 匹配 /api/ 下的接口，包括 /api/v1/*；handle 不删除 /api 前缀。
	# 浏览器可直接请求当前站点的 /api/v1/...，无需跨域访问另一个接口域名。
	handle /api/* {
		# 转发到 Gin 后端的容器内部端口；不是重新访问宿主机公网入口。
		reverse_proxy api:6324 {
			# 向后端传递直接连接 Caddy 的客户端 IP；header_up 修改发给上游的请求头。
			header_up X-Real-IP {remote_host}
		}
	}
	# 上传文件入口：handle_path 会剥离 /uploads/ 前缀。
	# 例如 /uploads/example.png 对应 /srv/uploads/example.png；该目录来自上传文件卷。
	handle_path /uploads/* {
		# 为当前处理分支指定文件根目录；* 表示匹配所有请求。
		root * /srv/uploads
		# 从上面设置的根目录返回静态文件；未开启目录浏览。
		file_server
	}
	# 不带匹配条件的兜底分支：处理未被其他 handle 分支接管的请求。
	handle {
		# 将页面与资源请求交给前台服务；api/web 服务名由 Docker 网络解析。
		reverse_proxy web:6325
	}
}

# 管理后台入口：接口同源代理，页面使用构建后的静态资源。
admin.retniw.cc {
	# 根据浏览器支持情况压缩可压缩响应，减少 HTML、CSS、JS 等传输体积。
	encode zstd gzip
	# 告诉浏览器按响应的 Content-Type 处理资源，不自行猜测文件类型。
	header X-Content-Type-Options nosniff
	# 匹配 /api/ 下的接口，包括 /api/v1/*；handle 不删除 /api 前缀。
	# 浏览器可直接请求当前站点的 /api/v1/...，无需跨域访问另一个接口域名。
	handle /api/* {
		# 转发到 Gin 后端的容器内部端口；不是重新访问宿主机公网入口。
		reverse_proxy api:6324 {
			# 向后端传递直接连接 Caddy 的客户端 IP；header_up 修改发给上游的请求头。
			header_up X-Real-IP {remote_host}
		}
	}
	# 上传文件入口：handle_path 会剥离 /uploads/ 前缀。
	# 例如 /uploads/example.png 对应 /srv/uploads/example.png；该目录来自上传文件卷。
	handle_path /uploads/* {
		# 为当前处理分支指定文件根目录；* 表示匹配所有请求。
		root * /srv/uploads
		# 从上面设置的根目录返回静态文件；未开启目录浏览。
		file_server
	}
	# 不带匹配条件的兜底分支：处理未被其他 handle 分支接管的请求。
	handle {
		# 后台静态文件根目录：Dockerfile.proxy 将 admin/dist 复制到这里。
		root * /srv/admin
		# 优先返回真实文件；找不到时返回 React 单页应用入口 index.html。
		# 这样直接打开或刷新后台子路由也能由前端路由接管。
		try_files {path} /index.html
		# 从上面设置的根目录返回静态文件；未开启目录浏览。
		file_server
	}
}

# 独立接口域名入口；本方案启用后，该域名也需要 DNS 解析和证书验证。
# 前台和后台的同源 /api/* 请求不依赖这个独立域名。
api.retniw.cc {
	# 告诉浏览器按响应的 Content-Type 处理资源，不自行猜测文件类型。
	header X-Content-Type-Options nosniff
	# 转发到 Gin 后端的容器内部端口；不是重新访问宿主机公网入口。
	reverse_proxy api:6324 {
		# 向后端传递直接连接 Caddy 的客户端 IP；header_up 修改发给上游的请求头。
		header_up X-Real-IP {remote_host}
	}
}
